.screen {
    flex-grow: 1; position: relative; align-items: stretch; color: #f2f6e8;
    background-color: #192d3a; font-size: 15px;
    -unity-font-definition: url("../Fonts/FrostlineSans.ttf");
}
.background {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("../Art/Expedition/Cover.png"); background-size: cover; background-position: center;
}
.title-screen { flex-grow: 1; justify-content: center; padding-left: 9%; }
.title-menu {
    width: 540px; max-width: 68%; padding: 20px 0 28px 25px; align-items: flex-start;
    border-left-width: 2px; border-left-color: rgba(220, 179, 122, 0.80);
}
.title-wordmark {
    margin: 0 0 5px; color: #b5d5d0; font-size: 16px; letter-spacing: 5px;
    -unity-font-style: bold;
}
.game-title {
    margin: 0; color: #f0e5cb; font-size: 88px; letter-spacing: 5px;
    -unity-font-style: bold;
}
.title-rule { width: 85px; height: 2px; margin-top: 14px; margin-bottom: 19px; background-color: #ceaa6e; }
.title-description { color: #bed5d1; margin: 0 0 31px; font-size: 21px; white-space: normal; }
.button.title-start { width: 230px; min-height: 56px; font-size: 21px; }
.title-actions { flex-direction: row; margin-top: 9px; }
.title-actions .button {
    min-height: 35px; margin-right: 8px; background-color: rgba(20, 45, 55, 0.88); border-color: #729390;
}
.title-actions .button:hover { background-color: #365b61; border-color: #e1c693; }
.title-guide {
    display: none; margin: 14px 0 0; width: 370px; max-width: 100%; padding: 12px;
    color: #d9e7df; font-size: 15px; white-space: normal;
    background-color: rgba(12, 32, 43, 0.91); border-radius: 5px; border-width: 1px; border-color: #527575;
}
.battle-hud { flex-grow: 1; position: relative; }
.battle-shade {
    position: absolute; top: 0; bottom: 0; left: 0; right: 0;
    background-color: rgba(10, 25, 32, 0.20);
}
.top {
    min-height: 92px; flex-shrink: 0; padding: 13px 2.5% 0; flex-direction: row;
    justify-content: space-between; align-items: flex-start;
}
.battle-location {
    flex-shrink: 1; min-width: 0; padding: 7px 16px 8px 13px;
    background-color: rgba(16, 30, 38, 0.94); border-radius: 3px;
    border-left-width: 3px; border-left-color: #d4ab72;
}
.title { margin: 0; font-size: 31px; color: #f5e9d0; -unity-font-style: bold; letter-spacing: 2px; }
.objective { margin: 1px 0 0; color: #b7d2cf; font-size: 14px; white-space: normal; }
.encounter {
    min-height: 53px; padding: 5px 12px; flex-direction: row; align-items: center; justify-content: center;
    border-bottom-width: 2px; border-bottom-color: #759995;
    border-radius: 3px; background-color: rgba(22, 43, 47, 0.93);
}
.turn { color: #f0e5ba; font-size: 19px; -unity-font-style: bold; margin-right: 17px; }
.wave { color: #c6e2df; font-size: 16px; }
.wave-units { color: #f1c9a6; font-size: 13px; }
.button {
    margin: 0; padding: 5px 14px; border-width: 1px; border-radius: 4px;
    color: #f2ede0; border-color: #778d88; background-color: #233e44;
    -unity-font-style: bold; font-size: 16px;
}
.button:hover { background-color: #3c6270; border-color: #bbdace; }
.button:disabled { opacity: 0.53; }
.top-actions { flex-direction: row; margin-left: 10px; }
.top-button {
    min-height: 37px; margin-left: 5px; padding: 5px 9px; font-size: 14px;
    background-color: rgba(17, 31, 38, 0.93); border-color: #638481;
}
.top-button.order-active { background-color: #624f36; color: #fff0bd; border-color: #dfb968; }
.arena { flex-grow: 1; flex-basis: 0; min-height: 0; justify-content: center; }
.side-labels { flex-direction: row; flex-shrink: 0; align-self: center; width: 88%; margin-bottom: 4px; padding: 0 20px; }
.side-label {
    flex-grow: 1; flex-basis: 0; height: 25px; font-size: 14px; letter-spacing: 2px;
    border-bottom-width: 1px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.crew-label { color: #e4f8ee; background-color: rgba(13, 38, 40, 0.90); border-bottom-color: #83b6aa; }
.enemy-label {
    color: #fce7db; background-color: rgba(60, 32, 40, 0.90); border-bottom-color: #c48b77;
    margin-left: 58px;
}
.formations { align-self: center; width: 88%; flex-grow: 1; flex-basis: 0; min-height: 0; max-height: 480px; padding: 3px 12px; }
.formation-row, .formation {
    flex-grow: 1; flex-basis: 0; min-height: 0;
}
.formation {
    margin-bottom: 7px; padding: 5px 8px; flex-direction: row; align-items: stretch; justify-content: center;
    background-color: rgba(15, 32, 40, 0.20);
    border-bottom-width: 1px; border-bottom-color: rgba(183, 208, 204, 0.60);
}
.side { flex-direction: row; align-items: stretch; justify-content: center; flex-grow: 1; flex-basis: 0; min-width: 0; }
.allies { justify-content: flex-end; }
.enemies { justify-content: flex-start; }
.midline { width: 58px; flex-shrink: 0; justify-content: center; align-items: center; }
.row-label {
    height: 24px; min-width: 42px; padding: 0 4px; border-radius: 12px; border-width: 1px;
    border-color: #829c93; background-color: #20383c; color: #f1efdb;
    -unity-text-align: middle-center; font-size: 12px;
}
.slot {
    position: relative; flex-grow: 1; flex-basis: 0; max-width: 180px; min-width: 0; margin: 0 5px; padding: 0;
    border-radius: 7px; border-width: 2px; align-items: stretch; justify-content: flex-start;
    background-color: #203e48; border-color: #91cbc2;
}
.hostile { background-color: #4a3a46; border-color: #da9c84; }
.slot.empty {
    background-color: rgba(15, 34, 39, 0.26); border-width: 1px;
    border-color: rgba(170, 208, 201, 0.41); justify-content: center;
}
.slot.hostile.empty { background-color: rgba(38, 30, 37, 0.13); border-color: rgba(213, 166, 153, 0.24); }
.unit-face, .card, .floating-card {
    padding: 4px; border-radius: 9px; border-width: 2px; border-bottom-width: 4px;
    border-color: #a0c2ba; border-bottom-color: #577e76; background-color: #263a3d;
}
.slot.hostile.unit-face { background-color: #40303c; border-color: #ca9c8e; border-bottom-color: #8d645d; }
.slot.leader { border-color: #efca75; }
.slot:hover { border-color: #f7efcb; }
.face-art {
    position: relative; flex-grow: 1; min-height: 30px; border-radius: 5px;
    background-size: cover; background-position: center; background-repeat: no-repeat;
    background-color: #335764;
}
.face-content {
    flex-grow: 1; flex-basis: 0; min-height: 0;
    -unity-font-definition: url("../Fonts/FrostlineSans.ttf");
}
.face-content .face-art {
    min-height: 0; flex-basis: 0;
    border-radius: 4px; background-color: #263c42;
    border-width: 1px; border-color: rgba(238, 223, 194, 0.40);
}
.unit-portrait { background-image: url("../CardArt/Expedition/SnowCaptain.png"); background-position: center 39%; }
.item-portrait { background-image: url("../CardArt/Expedition/Dye.png"); }
.card-caption {
    margin-top: 3px; padding: 0 4px 3px; flex-shrink: 0;
    background-color: #eee8d7; border-radius: 3px;
    border-top-width: 2px; border-top-color: #85a99e;
}
.hostile .card-caption { background-color: #f0dbd3; border-top-color: #d4a194; }
.item-content .card-caption { background-color: #f1e5ca; border-top-color: #c69a5f; }
.face-title {
    margin: 0; min-height: 23px; flex-shrink: 0; padding: 1px 2px;
    color: #203536; font-size: 16px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.hostile .face-title { color: #52323c; }
.item-card .face-title { color: #4a3429; }
.traits { flex-shrink: 0; align-items: center; padding-top: 2px; }
.trait-row { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.trait {
    padding: 0 4px; margin: 0 2px; border-radius: 3px; background-color: rgba(37, 67, 64, 0.14);
    color: #234247; font-size: 11px; -unity-text-align: middle-center;
}
.ability-value { flex-direction: row; align-items: center; justify-content: center; }
.ability-trigger, .ability-amount { font-size: 12px; color: #283c3d; }
.ability-amount { -unity-font-style: bold; }
.ability-icon, .resist-icon { width: 13px; height: 13px; background-size: contain; background-repeat: no-repeat; }
.ability-icon { background-image: url("../CardArt/icon_snow.png"); background-color: #425c61; border-radius: 3px; }
.resist-icon { background-color: #536b69; border-radius: 3px; }
.ability-value.silenced { opacity: 0.44; }
.unit-vitals { flex-direction: row; align-items: stretch; flex-shrink: 0; height: 22px; margin-bottom: 3px; }
.health-track {
    flex-grow: 1; min-width: 22px; position: relative; overflow: hidden;
    border-width: 1px; border-radius: 4px; border-color: #80b9aa; background-color: #162c29;
}
.health-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #3e7765; }
.health-value {
    flex-grow: 1; margin: 0; color: #fff4e0; font-size: 13px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.hostile .health-track { border-color: #e0a192; background-color: #412737; }
.hostile .health-fill { background-color: #894858; }
.effect-strip {
    flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 2px;
}
.effect-spice { background-color: #8c3c2e; }
.effect-overload { background-color: #795121; }
.effect-ink { background-color: #4a315c; }
.effect-weakness { background-color: #394979; }
.effect-block { background-color: #2a6069; }
.effect-bonus { background-color: #2f644c; }
.effect-thorns { background-color: #635338; }
.effect-burn { background-color: #934b2e; }
.effect-poison { background-color: #3c633c; border-color: #a9d68d; }
.effect-corruption { background-color: #66384c; border-color: #edacb6; }
.effect-exposed { background-color: #744552; }
.order-note {
    visibility: hidden; align-self: center; min-width: 235px; max-width: 80%;
    height: 26px; flex-shrink: 0; margin-bottom: 5px; padding: 0 12px;
    border-width: 1px; border-color: #6d9e9e; border-radius: 5px;
    background-color: #183440; color: #d7ebe4;
    font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.order-note.danger { color: #ffe0c7; border-color: #d68277; background-color: #593846; }
.empty-mark { color: rgba(234, 255, 250, 0.57); font-size: 18px; -unity-text-align: middle-center; }
.slot.target .empty-mark { color: #fff2cd; }
.stat {
    position: absolute; height: 26px; min-width: 32px; padding: 0 4px;
    flex-direction: row; justify-content: center; align-items: center;
    border-width: 1px; border-color: rgba(255, 246, 218, 0.72); border-radius: 6px;
}
.stat-health { background-color: #8f3851; }
.stat-attack { background-color: #245873; }
.stat-timer { background-color: #755222; }
.stat-snow { background-color: #245a84; border-color: #b4eaff; }
.stat-heal { background-color: #386c56; }
.stat-shell { background-color: #2a6266; border-color: #a8d7c3; }
.stat-crown { background-color: #795622; border-color: #f6d47f; }
.stat-pendant { background-color: #745531; border-color: #f4d689; }
.stat-icon { width: 15px; height: 15px; margin-right: 1px; flex-shrink: 0; background-size: contain; background-repeat: no-repeat; }
.attack-icon { background-image: url("../CardArt/icon_attack.png"); }
.timer-icon { background-image: url("../CardArt/icon_timer.png"); }
.stat-value { margin: 0; color: #fff8df; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; }
.vital-number, .unit-counter {
    position: relative; height: 22px; min-width: 26px; padding: 0 2px; margin-left: 2px;
    flex-shrink: 0; border-radius: 4px;
}
.vital-number .stat-icon { width: 11px; height: 11px; }
.vital-number .stat-value { font-size: 12px; }
.unit-counter { border-color: #e4ba75; background-color: #674023; }
.unit-counter .stat-icon { width: 11px; height: 11px; }
.unit-counter .stat-value { font-size: 13px; }
.effect-chip { position: relative; height: 18px; width: 27px; min-width: 0; padding: 0 1px; margin: 0 1px 1px 0; border-radius: 4px; }
.effect-chip .stat-icon { width: 11px; height: 11px; }
.effect-chip .stat-value { margin: 0; padding: 0; font-size: 11px; }
.effect-strip.dense .effect-chip { width: 24px; padding: 0; }
.effect-strip.dense .stat-icon { width: 10px; height: 10px; }
.effect-strip.dense .stat-value { font-size: 10px; }
.attack-corner { top: 3px; right: 3px; }
.item-effect-badge { right: 4px; bottom: 4px; padding: 0 4px; height: 24px; border-radius: 4px; }
.item-effect-badge .stat-icon { width: 14px; height: 14px; }
.item-effect-badge .stat-value { font-size: 13px; }
.rule-badge { position: relative; height: 20px; min-width: 31px; }
.rule-badge .stat-icon { width: 12px; height: 12px; }
.rule-badge .stat-value { font-size: 12px; }
.order-badge {
    position: absolute; left: 6px; top: 39%; width: 30px; height: 30px;
    border-radius: 15px; border-width: 2px; border-color: #fff1c5; background-color: #183545;
    color: #ffdb78; font-size: 18px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.arrival-badge {
    position: absolute; left: 4px; right: 4px; bottom: 32px; height: 26px;
    border-width: 1px; border-color: #efac87; border-radius: 4px; background-color: #593944;
    color: #ffe2bc; font-size: 14px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.forecast-chip {
    position: absolute; left: 2px; right: 2px; bottom: 1px; height: 20px;
    margin: 0; border-width: 1px; border-color: #63a6a7; border-radius: 3px;
    background-color: #28536a; color: #e3f6fa; font-size: 12px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.forecast-chip.forecast-danger { color: #ffe3ce; border-color: #df9a83; background-color: #67384a; }
.forecast-chip.forecast-gain { color: #e4f9d8; border-color: #9accaa; background-color: #335d55; }
.burst {
    position: absolute; left: 4px; right: 4px; top: 40%; height: 36px; border-radius: 5px;
    color: #fff1c7; background-color: rgba(85, 48, 43, 0.97); font-size: 23px; -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.ice-burst { color: #e5f6ff; background-color: #356289; }
.heal-burst { color: #e1ffd6; background-color: #376b4d; }
.status-burst { color: #f4e7ff; background-color: #4a315c; font-size: 17px; }
.overload-burst { color: #ffefbe; background-color: #852f20; }
.thorns-burst { color: #fff4bb; background-color: #695538; }
.burn-burst { color: #ffdeb8; background-color: #963e2b; }
.slot.target, .button.target { border-color: #ffe19f; background-color: rgba(86, 93, 70, 0.96); }
.slot.picked { border-color: #fff0a1; }
.slot.source { border-color: #ffbd7d; }
.slot.frozen { border-color: #8ad7ff; }
.slot.inspect { border-color: #ffedca; }
.slot.affected { border-color: #ffe27f; background-color: #8b6937; }
.slot.affected .face-art { opacity: 0.81; border-width: 2px; border-color: #ffe27f; }
.slot.possible { border-color: #dcbdff; background-color: #685477; }
.slot.possible .face-art { border-color: #dcbdff; }
.slot.incoming { border-color: #ff9374; background-color: #874756; }
.slot.drop-valid.empty, .slot.drop-valid.unit-face { border-color: #b9efd0; background-color: #376d63; }
.slot.drop-valid .face-art { border-color: #b9efd0; }
.slot.drop-invalid.empty, .slot.drop-invalid.unit-face { border-color: #e29691; }
.slot.motion-source, .card.motion-source { opacity: 0.30; }
.strike-trail { position: absolute; background-color: #fff8ce; rotate: 42deg; border-radius: 6px; }
.notice-bar {
    min-height: 34px; flex-shrink: 0; align-self: center; width: 88%;
    margin: 4px 0 7px; padding: 4px 12px; align-items: center; flex-direction: row;
    justify-content: space-between; border-radius: 3px;
    border-left-width: 2px; border-left-color: #81a9a0; background-color: rgba(15, 32, 38, 0.92);
}
.notice { color: #e6f0e5; font-size: 14px; flex-shrink: 1; white-space: normal; }
.hint { color: #f2d5ac; font-size: 14px; margin-left: 12px; flex-shrink: 1; white-space: normal; -unity-text-align: middle-right; }
.tray {
    height: 258px; flex-shrink: 0; padding: 7px 16px 11px; margin: 0 2.5% 11px;
    flex-direction: row; align-items: stretch; border-radius: 7px;
    background-color: rgba(17, 30, 35, 0.96); border-width: 1px; border-color: #526d6e;
    border-top-width: 2px; border-top-color: #927552;
}
.piles, .actions { flex-shrink: 0; width: 158px; justify-content: center; }
.piles { padding-right: 12px; }
.actions { padding-left: 12px; }
.button.pile-button {
    flex-direction: row; justify-content: space-between; align-items: center;
    height: 38px; padding: 3px 7px 3px 9px; margin-bottom: 4px; background-color: #1c3037; border-color: #516f70;
}
.button.pile-button:hover { background-color: #315763; border-color: #e4c995; }
.pile-name { color: #cde3df; font-size: 14px; }
.pile-count {
    min-width: 29px; padding: 1px 4px; border-radius: 4px; background-color: #0f2530;
    color: #f2d197; font-size: 16px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.deck-button { min-height: 41px; margin-top: 8px; }
.primary {
    min-height: 51px; background-color: #dfb981; border-width: 1px; border-color: #f4d7a7;
    border-bottom-width: 3px; border-bottom-color: #94704b; color: #2f2c28; white-space: normal;
}
.primary:hover { background-color: #f8daa0; border-color: #ffebc6; }
.hand-scroll { flex-grow: 1; min-width: 0; }
.hand-scroll .unity-scroll-view__content-container { flex-grow: 1; }
.hand { flex-grow: 1; min-width: 0; padding: 9px 4px 2px; justify-content: center; flex-direction: row; }
.hand.many-cards { justify-content: flex-start; }
.hand.many-cards .card { flex-grow: 0; flex-shrink: 0; flex-basis: 135px; }
.card {
    flex-grow: 1; flex-basis: 0; min-width: 0; max-width: 177px; margin: 0 4px;
    position: relative; justify-content: flex-start; align-items: stretch;
}
.card.item-card { background-color: #4a3c31; border-color: #c8a77a; border-bottom-color: #95714d; }
.card:hover { border-color: #fff0c0; translate: 0 -5px; }
.card.selected, .card.selected:hover { border-color: #ffdc91; background-color: #554730; translate: 0 -7px; }
.card.hand-target { border-color: #b9efd0; }
.item-rules {
    flex-shrink: 0; padding: 2px 0; margin: 0 2px;
    border-top-width: 1px; border-top-color: rgba(133, 103, 65, 0.34);
}
.item-secondary { flex-direction: row; justify-content: center; margin-top: 2px; }
.card-desc {
    min-height: 28px; margin: 0; padding: 1px 2px; font-size: 14px; white-space: normal;
    color: #463623; -unity-text-align: middle-center;
}
.card-desc.card-desc-long { font-size: 12px; }
.redraw { padding-left: 40px; position: relative; min-height: 57px; font-size: 17px; }
.bell-icon { position: absolute; left: 12px; top: 15px; width: 23px; height: 24px; background-image: url("../CardArt/icon_bell.png"); background-size: contain; background-repeat: no-repeat; }
.redraw-note { margin-top: 5px; color: #b7d1d3; font-size: 13px; -unity-text-align: middle-center; }
.junk-per-turn-note { display: none; color: #edcb92; }
.redraw.redraw-ready { background-color: #94c8aa; border-color: #cde6c0; }
.floating-card {
    position: absolute; justify-content: flex-start; align-items: stretch;
    border-color: #f7d592; background-color: #2c4a55;
}
.floating-card.item-card { background-color: #43372f; }
.floating-card.drop-ready { border-color: #c2f7d2; background-color: #3d705e; }
.floating-card.drop-blocked { border-color: #dc8b88; }
.overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; align-items: center; justify-content: center;
    background-color: rgba(6, 18, 32, 0.78);
}
.dialog {
    width: 520px; max-width: 94%; padding: 28px;
    background-color: #192d32; border-radius: 7px; border-width: 1px; border-color: #75908a;
    border-top-width: 3px; border-top-color: #bb935d;
}
.dialog.wide { width: 820px; }
.result-eyebrow { color: #8dc9c3; font-size: 14px; letter-spacing: 2px; }
.result-title { color: #ffe5ae; font-size: 34px; -unity-font-style: bold; }
.result-detail { margin-top: 8px; color: #d5e7de; white-space: normal; font-size: 16px; }
.choices { margin-top: 20px; flex-direction: row; }
.choices .button { margin-right: 8px; }
.choice-grid { flex-wrap: wrap; }
.choice-grid .selection-card {
    flex-grow: 1; flex-basis: 0; min-width: 151px; min-height: 174px; margin: 0 7px 7px 0; padding: 8px;
    align-items: stretch; justify-content: flex-start; background-color: #234148; border-color: #63847e;
}
.choice-grid .selection-card:hover { background-color: #335d66; border-color: #f1ce8b; translate: 0 -2px; }
.site-preview { height: 82px; border-radius: 5px; background-size: cover; background-position: center; flex-shrink: 0; }
.selection-card .face-art { height: 66px; min-height: 66px; flex-grow: 0; flex-shrink: 0; }
.selection-card.supply-choice .face-art { height: 118px; min-height: 118px; }
.selection-title { color: #ffe6b0; font-size: 20px; margin-top: 6px; -unity-text-align: middle-left; }
.selection-subtitle { color: #9ed7c8; font-size: 13px; white-space: normal; }
.selection-detail { color: #e1eee8; font-size: 14px; white-space: normal; -unity-font-style: normal; -unity-text-align: upper-left; margin-top: 5px; }
.loadout-choice .face-art { height: 105px; min-height: 105px; }
.loadout-strategy { color: #f1d29e; font-size: 13px; white-space: normal; margin-top: 5px; -unity-text-align: upper-left; }
.deck-preview {
    margin-top: 8px; padding: 7px; border-radius: 4px; background-color: #193645;
    color: #c4dedc; font-size: 13px; white-space: normal;
    -unity-font-style: normal; -unity-text-align: upper-left;
}
.dialog-actions { flex-direction: row; }
.button.dialog-action { margin: 7px 7px 0 0; align-self: flex-start; }

.deck-overlay { background-color: rgba(6, 17, 25, 0.86); }
.deck-panel {
    width: 1040px; height: 605px; max-width: 94%; max-height: 92%; padding: 20px 24px 22px;
    background-color: #192d32; border-radius: 7px; border-width: 1px; border-color: #75908a;
    border-top-width: 3px; border-top-color: #bb935d;
}
.deck-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.deck-navigation { flex-direction: row; }
.button.deck-tab { margin-right: 7px; min-height: 34px; background-color: #1c3b48; border-color: #557781; }
.button.deck-tab:hover { background-color: #365961; }
.button.deck-tab.current { background-color: #3b5a59; color: #fff0ca; border-color: #dbbb7f; }
.deck-summary { margin-top: 10px; margin-bottom: 11px; color: #a9cfcb; font-size: 14px; white-space: normal; }
.deck-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.deck-scroll { flex-grow: 1; min-width: 0; background-color: #102632; border-radius: 6px; border-width: 1px; border-color: #315261; }
.deck-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; padding: 10px 5px 5px 10px; }
.button.deck-tile {
    width: 127px; height: 107px; padding: 4px; margin: 0 5px 5px 0;
    justify-content: flex-start; align-items: stretch; position: relative; background-color: #213e4b; border-color: #52757d;
}
.button.deck-tile:hover, .button.deck-tile.current { border-color: #e4c995; background-color: #394a4a; }
.deck-tile .face-art { min-height: 34px; }
.deck-tile .item-effect-badge { height: 19px; right: 2px; bottom: 2px; }
.deck-tile .item-effect-badge .stat-icon { width: 11px; height: 11px; }
.deck-tile-title { color: #f3e5c5; font-size: 14px; margin-top: 3px; -unity-text-align: middle-center; }
.deck-tile-badge {
    position: absolute; right: 5px; top: 5px; padding: 1px 3px; border-radius: 3px;
    flex-direction: row; align-items: center; background-color: #162e36;
}
.deck-tile-count { font-size: 11px; color: #f3d38e; margin: 0; }
.deck-pendant { width: 14px; height: 14px; background-size: contain; background-repeat: no-repeat; }
.deck-detail {
    width: 240px; flex-shrink: 0; margin-left: 12px; padding: 14px; align-items: stretch;
    background-color: #1c3947; border-radius: 7px; border-width: 1px; border-color: #567f81;
}
.deck-card-role { color: #edc98a; font-size: 14px; -unity-font-style: bold; margin-bottom: 7px; }
.deck-card-face {
    height: 230px; flex-shrink: 0; position: relative; padding: 5px; align-items: stretch;
    border-width: 1px; border-radius: 7px; border-color: #819e97; background-color: #223d45;
}
.deck-card-description { margin-top: 10px; white-space: normal; color: #d3e4df; font-size: 14px; }
.deck-empty { color: #abcbc8; white-space: normal; font-size: 14px; }
