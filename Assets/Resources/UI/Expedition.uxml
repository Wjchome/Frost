<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="ExpeditionLayout.uss" />
  <ui:Template name="FormationRow" src="FormationRow.uxml" />
  <ui:VisualElement name="screen" class="screen">
    <ui:VisualElement name="background" class="background" picking-mode="Ignore" />
    <ui:VisualElement name="title-screen" class="title-screen">
      <ui:VisualElement class="title-menu">
        <ui:Label text="FROSTLINE DISPATCH" class="title-wordmark" />
        <ui:Label text="霜线信使" class="game-title" />
        <ui:VisualElement class="title-rule" picking-mode="Ignore" />
        <ui:Label text="雪原上的卡牌远征" class="title-description" />
        <ui:Button name="start-expedition" text="开始远征" class="button primary title-start" focusable="false" />
        <ui:VisualElement class="title-actions">
          <ui:Button name="title-help" text="玩法说明" class="button" focusable="false" />
          <ui:Button name="title-codex" text="图鉴 [C]" class="button" focusable="false" />
          <ui:Button name="title-sound" text="音效 开" class="button" focusable="false" />
        </ui:VisualElement>
        <ui:Label name="title-guide" text="开局先免费部署主角和随从。出牌推动倒计时，主角倒下即失败。Tab 查看行动顺序，B 查看牌组，空格换牌。" class="title-guide" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="battle-hud" class="battle-hud" style="display: none;">
      <ui:VisualElement class="battle-shade" picking-mode="Ignore" />
      <ui:VisualElement class="top">
        <ui:VisualElement class="battle-location">
          <ui:Label name="location-title" class="title" />
          <ui:Label name="objective" class="objective" />
        </ui:VisualElement>
        <ui:VisualElement class="encounter">
          <ui:Label name="turn" class="turn" />
          <ui:VisualElement>
            <ui:Label name="wave" class="wave" />
            <ui:Label name="wave-units" class="wave-units" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="top-actions">
          <ui:Button name="inspect-deck" text="牌组 [B]" class="button top-button" focusable="false" />
          <ui:Button name="battle-codex" text="图鉴 [C]" class="button top-button" focusable="false" />
          <ui:Button name="battle-gm" text="GM" class="button top-button gm-button" focusable="false" style="display: none;" />
          <ui:Button name="action-order" text="行动预览 [Tab]" class="button top-button" />
          <ui:Button name="battle-sound" class="button top-button" focusable="false" />
          <ui:Button name="restart" text="重开本战" class="button top-button" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="arena">
        <ui:Label name="order-note" class="order-note" picking-mode="Ignore" />
        <ui:VisualElement class="side-labels">
          <ui:Label text="探险队" class="side-label crew-label" />
          <ui:Label text="拦路者" class="side-label enemy-label" />
        </ui:VisualElement>
        <ui:VisualElement name="formations" class="formations">
          <ui:Instance name="upper-row" template="FormationRow" class="formation-row" />
          <ui:Instance name="lower-row" template="FormationRow" class="formation-row" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="tray">
        <ui:VisualElement class="piles">
          <ui:Button name="inspect-draw" class="button pile-button" focusable="false">
            <ui:Label text="抽牌堆" class="pile-name" />
            <ui:Label name="draw-count" class="pile-count" />
          </ui:Button>
          <ui:Button name="inspect-discard" class="button pile-button" focusable="false">
            <ui:Label text="弃牌堆" class="pile-name" />
            <ui:Label name="discard-count" class="pile-count" />
          </ui:Button>
          <ui:Button name="inspect-exhaust" class="button pile-button" focusable="false">
            <ui:Label text="消耗堆" class="pile-name" />
            <ui:Label name="exhaust-count" class="pile-count" />
          </ui:Button>
          <ui:Button name="recall" text="收回队员" class="button deck-button" />
        </ui:VisualElement>
        <ui:ScrollView name="hand-scroll" mode="Horizontal" class="hand-scroll" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
          <ui:VisualElement name="hand" class="hand" />
        </ui:ScrollView>
        <ui:VisualElement class="actions">
          <ui:Button name="redraw" class="button primary redraw">
            <ui:VisualElement class="bell-icon" picking-mode="Ignore" />
          </ui:Button>
          <ui:Label name="redraw-note" class="redraw-note" />
          <ui:Label name="junk-per-turn-note" class="redraw-note junk-per-turn-note" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="overlay" class="overlay">
      <ui:VisualElement name="dialog" class="dialog">
        <ui:Label name="result-eyebrow" class="result-eyebrow" />
        <ui:Label name="result-title" class="result-title" />
        <ui:Label name="result-detail" class="result-detail" />
        <ui:VisualElement name="choices" class="choices" />
        <ui:VisualElement class="dialog-actions">
          <ui:Button name="change-loadout" text="返回主角选择" class="button dialog-action" focusable="false" />
          <ui:Button name="route-deck" text="查看牌组 [B]" class="button dialog-action" focusable="false" />
          <ui:Button name="route-codex" text="图鉴 [C]" class="button dialog-action" focusable="false" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="deck-overlay" class="overlay deck-overlay">
      <ui:VisualElement name="deck-panel" class="deck-panel">
        <ui:VisualElement class="deck-heading">
          <ui:Label name="deck-title" text="牌组一览" class="result-title" />
          <ui:VisualElement class="deck-heading-actions">
            <ui:Button name="gm-back" text="返回 GM" class="button gm-button" focusable="false" style="display: none;" />
            <ui:Button name="gm-add-card" text="加入手牌" class="button gm-button" focusable="false" style="display: none;" />
            <ui:Button name="close-deck" text="关闭 [Esc]" class="button" focusable="false" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="deck-navigation">
          <ui:Button name="deck-roster-tab" class="button deck-tab" focusable="false" />
          <ui:Button name="deck-draw-tab" class="button deck-tab" focusable="false" />
          <ui:Button name="deck-discard-tab" class="button deck-tab" focusable="false" />
          <ui:Button name="deck-exhaust-tab" class="button deck-tab" focusable="false" />
        </ui:VisualElement>
        <ui:VisualElement name="codex-tabs" class="deck-navigation" />
        <ui:Label name="deck-summary" class="deck-summary" />
        <ui:VisualElement name="gm-menu" class="gm-menu" style="display: none;" />
        <ui:VisualElement name="gm-enemy-placement" class="gm-enemy-placement" style="display: none;">
          <ui:Label text="选择敌方空位 · 1 号在最前方" class="gm-placement-label" />
          <ui:VisualElement name="gm-enemy-slots" class="gm-enemy-slots" />
        </ui:VisualElement>
        <ui:VisualElement name="deck-body" class="deck-body">
          <ui:ScrollView name="deck-scroll" class="deck-scroll" mode="Vertical">
            <ui:VisualElement name="deck-grid" class="deck-grid" />
          </ui:ScrollView>
          <ui:VisualElement name="deck-detail" class="deck-detail" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
